# ---------- Server ----------
PORT=3000
NODE_ENV=development
# Long random string used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# ---------- Database (Turso / libSQL) ----------
# For LOCAL DEVELOPMENT, point this at a local file instead - no Turso
# account needed yet, no auth token needed. The exact same client library
# and code works against a local file or a remote Turso database:
TURSO_DATABASE_URL=file:./backend/db/local.db
# TURSO_AUTH_TOKEN stays blank for local file mode.

# For PRODUCTION, replace both with your real Turso database (see
# docs/02-turso-setup.md), e.g.:
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=ey...
TURSO_AUTH_TOKEN=

# ---------- Admin seed (used once by `npm run seed-admin`) ----------
ADMIN_EMAIL=admin@mellow.example
ADMIN_PASSWORD=change-this-password

# ---------- File storage ----------
# "local" saves uploaded ID/shop photos to backend/uploads (fine for local dev/testing)
# "r2" saves them to Cloudflare R2 (use this in production/Render, since Render's
# filesystem is not persistent across deploys)
STORAGE_MODE=local

# Only needed when STORAGE_MODE=r2 (see docs/03-r2-setup.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mellow-uploads
